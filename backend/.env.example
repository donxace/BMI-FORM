
# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# Required — the app refuses to start without this. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required for the inventory-collector agent-report endpoint. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SHARED_SECRET=

# Comma-separated extra CORS origins beyond localhost/private-LAN ranges
# (see main.ts). Usually leave blank.
CORS_EXTRA_ORIGINS=

# Used to build the link inside password-reset emails
# (http://<FRONTEND_URL>/reset-password?token=...). Point this at
# whatever host/port the frontend is actually served from.
FRONTEND_URL=http://localhost:5174

# SMTP — required for "Forgot password?" to actually send an email.
# For Gmail: SMTP_USER is the full Gmail address, SMTP_PASS is a 16-char
# App Password (myaccount.google.com/apppasswords — requires 2-Step
# Verification to be on; a regular account password will NOT work here).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if left blank.
SMTP_FROM=
